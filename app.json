{
  "expo": {
    "name": "Ихсан",
    "slug": "ihsan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ihsan",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#071526",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071526"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.emirkhan.ihsan",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Геолокация нужна, чтобы рассчитать время намаза и направление на Каабу для вашего места. Координаты не передаются нам и не сохраняются на серверах."
      }
    },
    "android": {
      "package": "kg.emirkhan.ihsan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#071526"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы рассчитать время намаза и направление на Каабу для вашего места. Координаты не передаются нам и не сохраняются на серверах."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A9F06B"
        }
      ],
      "expo-asset",
      "./plugins/withoutAudioServices",
      "./plugins/withUploadSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
